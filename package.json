{
  "name": "hd-agent",
  "version": "0.9.0",
  "description": "HD Agent is a Bun-native extension pack for Pi: web access, subagents, revamped core tools, ANSI-compatible themes, fzf-style completions, Telegram mode, and more.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "agent"
  ],
  "homepage": "https://github.com/tuong-nguyen-vn/hd-agent#readme",
  "bugs": {
    "url": "https://github.com/tuong-nguyen-vn/hd-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuong-nguyen-vn/hd-agent.git"
  },
  "bin": {
    "hd-agent": "bin/pim.ts",
    "amp-pi": "bin/pim.ts",
    "pi": "bin/pim.ts"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.2.21"
  },
  "pi": {
    "extensions": [
      "./src/extensions"
    ],
    "themes": [
      "./src/themes"
    ],
    "image": "https://raw.githubusercontent.com/tuong-nguyen-vn/hd-agent/refs/heads/main/assets/demo.webp"
  },
  "scripts": {
    "dev": "bun link && hd-agent",
    "typecheck": "tsgo --noEmit",
    "test": "bun test src --only-failures",
    "lint": "oxlint . --fix",
    "format": "prettier --write --list-different package.json tsconfig.json .oxlintrc.json .prettierrc.json \"src/**/*.ts\" \"bin/**/*.ts\"",
    "check": "bun run typecheck && bun run test && bun run lint && bun run format"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260612.1",
    "oxlint": "^1.69.0",
    "prettier": "^3.8.4"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "2.4.0",
    "diff": "^9.0.0",
    "fzf": "^0.5.2",
    "grammy": "^1.44.0",
    "ignore": "^7.0.5",
    "ky": "^2.0.2",
    "pi-devin-auth": "^0.1.2",
    "pi-mcp-adapter": "2.11.0"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "ws": "^8.21.1",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "undici": "^8.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@hono/node-server": "^2.0.12"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "koffi@2.16.3": true,
    "protobufjs@7.6.5": true
  }
}
